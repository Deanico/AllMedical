VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Sheets - Existing Lead Sync
GOOGLE_SHEET_ID=your_lead_sheet_id
GOOGLE_SHEET_RANGE=Sheet1!A2:R
GOOGLE_SHEET_ROW_LIMIT=1000
# Extra tabs in the same sheet: separate ranges with "|" e.g. Sheet1!A2:R|Sheet2!A2:R
# Extra sheet (same column layout); repeat as _3, _4 ... if needed
# GOOGLE_SHEET_ID_2=second_sheet_id
# GOOGLE_SHEET_RANGE_2=Sheet1!A2:R
# AI Agent leads are detected from the ad_name column (D / index 3) by default.
# Add Sheet2 to GOOGLE_SHEET_RANGE if it contains those leads, e.g. Sheet1!A2:R|Sheet2!A2:R.
# Set SHEET_AD_NAME_COLUMN if ad_name is in a different zero-based column.
# SHEET_AD_NAME_COLUMN=3
# The original created_time column is B (index 1) by default.
# SHEET_CREATED_TIME_COLUMN=1

# Google Sheets - Financial Reports Sync
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

GOOGLE_CLAIMS_SHEET_ID=your_paid_claims_sheet_id
GOOGLE_CLAIMS_SHEET_RANGE=Paid Claims!A2:F
CLAIMS_DATE_COLUMN=0
CLAIMS_PATIENT_COLUMN=1
CLAIMS_PAYER_COLUMN=2
CLAIMS_AMOUNT_COLUMN=3
CLAIMS_ID_COLUMN=4
CLAIMS_NOTES_COLUMN=5

GOOGLE_OPS_SHEET_ID=your_expenses_shipments_sheet_id
GOOGLE_OPS_SHEET_RANGE=Expenses & Shipments!A2:G
OPS_DATE_COLUMN=0
OPS_TYPE_COLUMN=1
OPS_CATEGORY_COLUMN=2
OPS_DESCRIPTION_COLUMN=3
OPS_VENDOR_COLUMN=4
OPS_AMOUNT_COLUMN=5
OPS_NOTES_COLUMN=6
FINANCIAL_SYNC_INTERVAL_MINUTES=0
FINANCIAL_SYNC_RUN_ON_START=false

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_BASE_URL=https://your-public-site.example
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_YOUR_PHONE_NUMBER=+1234567890
